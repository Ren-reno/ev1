@startuml sec-registrar-actividad-evidencia
title Secuencia — Registrar Actividad con Evidencia y Validación (HU-01, HU-09, HU-10, HU-11)

actor Funcionario
participant "Sistema SGR" as SGR
actor Verificador

Funcionario -> SGR: registrarActividad(datos)
activate SGR
SGR -> SGR: validar campos (RF-010)
SGR -> SGR: generarCodigoVerificador()
note right: <<include>> HU-10 (RF-011)
SGR --> Funcionario: actividad registrada + código
deactivate SGR

Funcionario -> SGR: adjuntarEvidencia(código, archivo)
activate SGR
SGR -> SGR: validar formato y tamaño\n(usa ConfiguracionSistema, RNF-017)
SGR --> Funcionario: evidencia adjuntada,\npendiente de validación
deactivate SGR

...tiempo después...

Verificador -> SGR: listarEvidenciasPendientes()
activate SGR
SGR --> Verificador: lista de evidencias
deactivate SGR

Verificador -> SGR: validarEvidencia(evidencia, decisión, observación)
activate SGR
note right: <<include>> HU-11 (RF-013)
alt decisión == aprobada
  SGR -> SGR: incorporar actividad al avance (RF-014, RN-009)
else decisión == rechazada / corrección
  SGR -> SGR: no incorporar al avance
end
SGR --> Verificador: confirmación
deactivate SGR

@enduml
