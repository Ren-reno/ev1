@startuml sec-registrar-actividad-evidencia
title Secuencia — Registrar Actividad con Evidencia y Validación (HU-01, HU-09, HU-10, HU-11)

actor Funcionario
participant "Sistema SGR" as Sistema
participant "Actividad" as Act
participant "Evidencia" as Evi
participant "ConfiguracionSistema" as Config
participant "Validacion" as Val
participant "Indicador" as Ind
actor Verificador

Funcionario -> Sistema: registrarActividad(datos)
activate Sistema
Sistema -> Sistema: validar campos (RF-010)
Sistema -> Act: crear(datos)
activate Act
Act -> Act: generarCodigoVerificador() (RF-011)
Act --> Sistema: código generado
deactivate Act
Sistema --> Funcionario: actividad registrada + código
deactivate Sistema

Funcionario -> Sistema: adjuntarEvidencia(código, archivo)
activate Sistema
Sistema -> Evi: crear(codigo, archivo)
activate Evi
Evi -> Config: obtenerFormatosYTamanoPermitido() (RNF-017)
activate Config
Config --> Evi: formatos y tamaño máximo
deactivate Config
Evi -> Act: adjuntarEvidencia(e)
Evi --> Sistema: evidencia registrada
deactivate Evi
Sistema --> Funcionario: evidencia adjuntada,\npendiente de validación
deactivate Sistema

...tiempo después...

Verificador -> Sistema: listarEvidenciasPendientes()
activate Sistema
Sistema --> Verificador: lista de evidencias
deactivate Sistema

Verificador -> Sistema: validarEvidencia(evidencia, decision, observacion)
activate Sistema
Sistema -> Val: registrar(decision, observacion) (RF-013)
activate Val
alt decisión == aprobada
  Val -> Ind: recalcularAvance() (RF-014, RN-009)
  activate Ind
  Ind --> Val: avance actualizado
  deactivate Ind
else decisión == rechazada / corrección
  Val -> Val: registrar observación\n(no incorpora al avance)
end
Val --> Sistema: validación registrada
deactivate Val
Sistema --> Verificador: confirmación
deactivate Sistema

@enduml
